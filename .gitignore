# ==========================================
# Python
# ==========================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ==========================================
# IDE / OS
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================
# Databases
# ==========================================
# Ignore empty/temp DBs
db/*.db
db/*.db-journal

# But KEEP the main working DB (small, 700 KB)
!nifty100.db

# Keep schema (source-controlled)
!db/schema.sql

# Temp DB artifacts
*.db-journal
*.db-wal
*.db-shm

# ==========================================
# Raw Data — large Excel source files
# ==========================================
data/raw/*.xlsx
data/raw/*.xls
data/processed/*.csv
data/processed/*.xlsx

# But keep the samples (if any)
!data/raw/.gitkeep
!data/processed/.gitkeep

# ==========================================
# Output files
# ==========================================
# Ignore generated/intermediate outputs
output/*.xlsx
output/*.png
output/*.log
output/*_generated.csv
output/skipped_*.csv
output/parse_*.csv
output/*_edge_cases.log

# BUT keep Sprint deliverables (small, important)
!output/valuation_summary.xlsx
!output/valuation_flags.csv
!output/qa_sprint4_log.md
!output/top_20_composite_scores.xlsx

# ==========================================
# Generated reports
# ==========================================
reports/radar_charts/
reports/portfolio/
reports/tearsheets/
reports/sector/

# Keep markdown reports
!reports/**/*.md
!reports/**/*.csv

# ==========================================
# Debug / Temporary
# ==========================================
*.log
.ipynb_checkpoints/
~$*.xlsx
*.tmp
*.bak
.tmp/
.temp/

# ==========================================
# Jupyter
# ==========================================
.ipynb_checkpoints/
*.ipynb

# ==========================================
# Testing
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ==========================================
# Notebooks (large, data-heavy)
# ==========================================
notebooks/*.ipynb
# Sprint 5 debug scripts
scripts/debug/

# Reports (regenerable)
reports/portfolio/
reports/tearsheets/
reports/sector/